# Скопируйте в .env и укажите свои пути. Файл .env не попадает в git.

# Папка с приватным хранилищем контента (репозиторий french_learning_materials)
CONTENT_DIR=

# Папка с исходными материалами преподавателя (только чтение; для путей аудио и видео)
SOURCE_MATERIALS_DIR=

# Адрес и порт сервера. По умолчанию доступно только с этого компьютера.
HOST=127.0.0.1
PORT=8000

# Ключ DeepL для перевода при выделении (необязательно; по умолчанию — MyMemory без ключа).
# Бесплатный ключ: https://www.deepl.com/pro-api . Сервис выбирается на странице «Настройки».
DEEPL_API_KEY=
